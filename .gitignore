# Build folder.
/build/

# Test output folder.
/tests/data/

# Media folders.
/media
/media_internal

# Packman folders.
/external/packman/
/tools/.packman/

# IDE folders.
/.vs/
/.vscode/
/.vscode-default/

# User files.
/CMakeUserPresets.json

# File types.
*.user
*.suo
*.pyc
*.VC.db
*.VC.opendb
*.pyc
*slang-dump-*
*.mp4
*.tlog
*.bak
*.swp

# experiment files
/experiments*
/Source/trash*

# Keep release examples in version control while other experiments stay local.
!/experiments/
/experiments/*
!/experiments/tof_restir_release/

# Legacy render passes kept locally and left out of the build until they are checked
/Source/RenderPasses/TempPasses/

# Local files kept out of the repository
/temp/

# Reference code (ReSTIR PT, Reservoir Splatting), kept locally only
/ReSTIR_PT-master/
/reference_code/

# CMake output when it is run in the source folder (builds go in build/).
/CMakeFiles/
/cmake_install.cmake
/git_version/
/git_version_state

# Falcor files this fork does not use; kept locally, not in the repository.
/environment.yml
/docs/
/tests/
